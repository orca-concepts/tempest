# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=concept_hierarchy
DB_USER=postgres
DB_PASSWORD=your_password_here

# Server Configuration
PORT=5000
NODE_ENV=development

# Comma-separated list of allowed CORS origins (e.g. http://localhost:5173,https://yourdomain.com)
CORS_ORIGINS=http://localhost:5173

# JWT Secret (change this to a random string in production)
JWT_SECRET=change_me_to_a_random_string
JWT_EXPIRES_IN=90d

ADMIN_USER_ID=1

ENABLED_ATTRIBUTES=value,action,tool,question

# Comma-separated list of enabled document tags. Leave empty to show all tags.
ENABLED_DOCUMENT_TAGS=preprint,protocol,grant application,review article,dataset,thesis,textbook,lecture notes,commentary

# Twilio env vars removed in Phase 61d/e. See ORCA_HISTORY.md for context.

# Resend (transactional email — Phase 61a)
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM_ADDRESS=noreply@orcaconcepts.org
EMAIL_FROM_NAME=Orca
FRONTEND_BASE_URL=http://localhost:5173

# ORCID OAuth (Phase 41a)
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=
ORCID_REDIRECT_URI=http://localhost:3000/orcid/callback
ORCID_BASE_URL=https://orcid.org